# Public origin of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). Server-side only in Phase 1: the browser
# never talks to Supabase directly. Either the legacy anon JWT or the newer
# sb_publishable_... key works here — both are subject to RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
