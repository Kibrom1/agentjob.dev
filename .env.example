# -----------------------------------------------------------------------------
# AgentJobs.dev environment. Copy to .env.local for development and add the
# same keys in Vercel → Project → Settings → Environment Variables.
# Lines marked 🔐 are secrets: never commit real values.
# -----------------------------------------------------------------------------

# Public origin (canonical URLs, sitemap, email links). Production only on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Public key (anon JWT or sb_publishable_...): used for all public reads.
SUPABASE_ANON_KEY=
# 🔐 service_role / sb_secret_ key: posting, admin, digest, rate limiting.
SUPABASE_SERVICE_ROLE_KEY=

# 🔐 Stripe → Developers → API keys / Webhooks (endpoint: /api/stripe/webhook,
# events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 🔐 Resend (https://resend.com) — the sending domain must be verified.
RESEND_API_KEY=
EMAIL_FROM="AgentJobs <digest@agentjobs.dev>"
EMAIL_REPLY_TO=
# Physical mailing address shown in every digest (CAN-SPAM requirement).
POSTAL_ADDRESS=

# 🔐 Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=

# 🔐 HTTP Basic credentials for /admin (password: 12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
