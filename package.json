    "test": "vitest run",
    "test:watch": "vitest",
    "test:ingest": "cd ingestion && python3 -m pytest",
    "test:e2e": "./scripts/test-e2e.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "geist": "1.7.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "playwright": "1.56.0",
    "postcss": "8.5.28",
