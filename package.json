{
  "name": "agentjobs",
  "version": "1.0.0",
  "private": true,
  "description": "AgentJobs.dev — the job board for AI agent and multi-agent systems engineers.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
